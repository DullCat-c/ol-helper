{
  "name": "@dullcat/ol-helper",
  "version": "0.0.1",
  "main": "./dist/ol-helper.es.js",
  "types": "./dist/ol-helper.d.ts",
  "homepage": "https://dullcat-c.github.io/ol-helper/",
  "keywords": [
    "openlayers",
    "utils"
  ],
  "files": [
    "dist"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/DullCat-c/ol-helper"
  },
  "scripts": {
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier --write  \"*.{js,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "publish": "npm version patch && npm publish --access public",
    "build": "vite build"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ol-helper.d.ts",
        "default": "./dist/ol-helper.es.js"
      }
    },
    "./package.json": "./package.json"
  },
  "lint-staged": {
    "*.{html,ts,js,json,jsx,tsx}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{js,ts,jsx,tsx,json,mjs}": [
      "eslint --fix"
    ]
  },
  "author": "John Tsai",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^18.19.70",
    "@unocss/preset-attributify": "^66.3.3",
    "@unocss/preset-icons": "^66.3.3",
    "@unocss/preset-wind4": "^66.3.3",
    "@vitejs/plugin-vue": "^3.2.0",
    "element-plus": "^2.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "postcss-html": "^1.8.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "unocss": "^66.3.3",
    "unplugin-auto-import": "^0.14.4",
    "unplugin-vue-components": "^0.22.12",
    "vite": "^3.2.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "2.0.0-alpha.13",
    "vue": "^3.5.24",
    "vue-codemirror": "^6.1.1",
    "vue-tsc": "^3.1.8"
  },
  "dependencies": {
    "ol": "^7.5.2"
  },
  "engines": {
    "node": ">21"
  }
}
